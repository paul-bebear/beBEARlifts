<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppGroupIdentifier</key>
	<string>$(APP_GROUP_IDENTIFIER)</string>
	<key>ForkOfflineOnly</key>
	<true/>
	<key>NSHealthShareUsageDescription</key>
	<string>$(APP_DISPLAY_NAME) reads your heart rate and active energy from Apple Health during a workout to show them on the watch.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>$(APP_DISPLAY_NAME) saves your completed workouts and their active energy to Apple Health.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Iosevka-Regular.ttf</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
